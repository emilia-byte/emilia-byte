# Session cookies — real auth tokens, never commit
sessions/

# Browser profile data — cached auth, can be large
browser_profiles/

# Debug screenshots — may show account info
*.png

# Real credential spreadsheets
*.xlsx
!BFL_Info_dummy.xlsx

# Multilogin credentials (local-only, never commit)
mlx_env.ps1

# Generated post images (recreated by generate_posts.py each run)
images/
image_suggestions.txt

# Credentials
.env

# Generated output
*.pdf
posts.txt

# Runtime state: which post.py published, for boost.py to verify against
last_post.json

# Runtime state: last-used destination URL, remembered between generate_posts.py runs
current_url.json

# One-off generation scripts
make_demo_brief.py
make_arch_pdf.py

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
